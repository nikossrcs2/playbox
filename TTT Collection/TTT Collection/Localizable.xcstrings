    "Tap targets as fast as possible.\n30 seconds. Ready?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe Ziele so schnell wie möglich. \n30 Sekunden. Bereit?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los objetivos lo más rápido posible.\n30 segundos. ¿Listo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les cibles aussi vite que possible.\n30 secondes. Prêt ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i bersagli più velocemente possibile.\n30 secondi. Pronto?"
          }
        },
        "ru": {
