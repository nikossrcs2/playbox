    "On each turn, choose to place either X or O anywhere. First to get three in a row wins.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in jedem Zug, ob du X oder O irgendwo platzierst. Wer zuerst drei in eine Reihe bekommt, gewinnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cada turno, elige colocar X u O en cualquier lugar. El primero en conseguir tres en raya gana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque tour, choisissez de placer X ou O n'importe où. Le premier à obtenir trois d'affilée gagne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni turno, scegli di posizionare X o O ovunque. Il primo a fare tre in fila vince."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каждом ходу выбирайте, куда поставить X или O. Первый, кто соберёт три в ряд, побеждает."
          }
        }
      }
    },
