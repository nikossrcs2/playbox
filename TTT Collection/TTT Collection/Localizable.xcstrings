    "Draw cards and try to get as close to 21 as you can without busting!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Karten und versuche so nah wie möglich an 21 zu kommen, ohne zu überkaufen!"
          }
        },
        "es": {
