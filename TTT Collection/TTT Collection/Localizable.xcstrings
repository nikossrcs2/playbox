          }
        }
      }
    },
    "Brick Breaker": {
      "shouldTranslate": false
    },
    "Build four foundation piles from Ace to King by suit. Move cards between tableau columns to uncover hidden cards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue vier Ablagestapel von Ass bis König nach Farbe auf. Verschiebe Karten zwischen den Spalten, um verdeckte Karten aufzudecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye cuatro pilas de fundación del As al Rey por palo. Mueve cartas entre columnas del tableau para descubrir cartas ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez quatre piles de fondation de l'As au Roi par couleur. Déplacez des cartes entre les colonnes du tableau pour découvrir les cartes cachées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci quattro pile fondazione dall'Asso al Re per seme. Sposta le carte tra le colonne del tableau per scoprire le carte nascoste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постройте четыре стопки от Туза до Короля по масти. Перемещайте карты между колонками, чтобы открыть скрытые карты."
          }
        }
      }
    },
