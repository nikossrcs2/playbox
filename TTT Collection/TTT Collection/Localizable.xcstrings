    "Move diagonally forward. Capture opponent pieces by jumping over them. Get to the back row to become a king.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege dich diagonal vorwärts. Schlage gegnerische Steine, indem du über sie springst. Erreiche die letzte Reihe, um König zu werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévete diagonalmente hacia adelante. Captura piezas saltando sobre ellas. Llega a la última fila para ser rey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-vous en diagonale vers l'avant. Capturez les pièces adverses en sautant par-dessus. Atteignez la rangée du fond pour devenir roi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoviti diagonalmente in avanti. Cattura le pedine saltandoci sopra. Raggiungi l'ultima riga per diventare re."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайтесь по диагонали вперёд. Захватывайте фигуры, перепрыгивая через них. Доберитесь до последней строки, чтобы стать королём."
          }
        }
      }
    },
