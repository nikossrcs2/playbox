    "Guess the 5-letter word in 6 tries. Green = correct position, Yellow = wrong position, Gray = not in word.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Errate das 5-Buchstaben-Wort in 6 Versuchen. Grün = richtige Position, Gelb = falsche Position, Grau = nicht im Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adivina la palabra de 5 letras en 6 intentos. Verde = posición correcta, Amarillo = posición incorrecta, Gris = no está en la palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devinez le mot de 5 lettres en 6 essais. Vert = bonne position, Jaune = mauvaise position, Gris = absent du mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indovina la parola di 5 lettere in 6 tentativi. Verde = posizione corretta, Giallo = posizione sbagliata, Grigio = non nella parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Угадайте слово из 5 букв за 6 попыток. Зелёный = верная позиция, Жёлтый = неверная позиция, Серый = нет в слове."
          }
        }
      }
    },
